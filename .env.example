# ============================================================
# BioTerrace Sentinel — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# --- Local Ollama (zero-cost, runs on-device) ---------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# --- ElevenLabs Creator Tier (voice synthesis) --------------
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here

# --- Bright Data Web Unlocker ($300 credit) -----------------
BRIGHTDATA_API_KEY=your_brightdata_api_key_here
BRIGHTDATA_PROXY_HOST=brd.superproxy.io
BRIGHTDATA_PROXY_PORT=22225
BRIGHTDATA_PROXY_USERNAME=your_brightdata_username_here
BRIGHTDATA_PROXY_PASSWORD=your_brightdata_password_here

# --- App Defaults -------------------------------------------
DEFAULT_REGION=himalaya
DB_PATH=app/db/road_cache.db
