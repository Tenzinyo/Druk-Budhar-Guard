{
  "name": "bioterrace-sentinel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev":          "vite",
    "build":        "tsc && vite build",
    "preview":      "vite preview",
    "lint":         "tsc --noEmit",

    "cap:sync":     "npx cap sync",
    "cap:android":  "npx cap sync android && npx cap open android",
    "cap:ios":      "npx cap sync ios     && npx cap open ios",
    "cap:run:android": "npx cap run android --livereload --external",
    "cap:run:ios":  "npx cap run ios --livereload --external"
  },
  "dependencies": {
    "react":     "^18.3.1",
    "react-dom": "^18.3.1",

    "@capacitor/camera":               "^6.0.0",
    "@capacitor/core":                 "^6.0.0",
    "@capacitor/android":              "^6.0.0",
    "@capacitor/ios":                  "^6.0.0",

    "@capacitor/motion":               "^6.0.0",
    "@capacitor/network":              "^6.0.0",
    "@capacitor/preferences":          "^6.0.0",
    "@capacitor/haptics":              "^6.0.0",
    "@capacitor/local-notifications":  "^6.0.0",
    "@capacitor/splash-screen":        "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli":        "^6.0.0",
    "@types/react":          "^18.3.3",
    "@types/react-dom":      "^18.3.0",
    "@vitejs/plugin-react":  "^4.3.1",
    "typescript":            "^5.5.3",
    "vite":                  "^5.3.4",
    "vite-plugin-pwa":       "^0.20.0"
  }
}
